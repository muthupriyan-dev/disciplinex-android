# Telegram bot token from @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token

# Your own Telegram chat id — bot sends approvals/summaries here
OWNER_CHAT_ID=your_telegram_chat_id

# AI provider keys — fallback chain tries them in this order:
# gemini-2.5-flash -> gemini-2.5-flash-lite -> gemini-2.0-flash
# -> groq -> openrouter -> cohere -> huggingface
GEMINI_API_KEY=your_gemini_key
GROQ_API_KEY=your_groq_key
OPENROUTER_API_KEY=your_openrouter_key
COHERE_API_KEY=your_cohere_key
HF_API_KEY=your_huggingface_key

# Render sets PORT automatically, this is just a local fallback
PORT=3000
